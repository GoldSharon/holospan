HOLOSPAN_ENV=development
HOLOSPAN_POSTGRES_DB=holospan
HOLOSPAN_POSTGRES_USER=holospan
HOLOSPAN_POSTGRES_PASSWORD=replace-with-a-long-random-password
HOLOSPAN_AUTH_DB_USER=holospan_auth
HOLOSPAN_AUTH_DB_PASSWORD=replace-with-a-distinct-long-random-password
HOLOSPAN_TENANT_DB_USER=holospan_tenant
HOLOSPAN_TENANT_DB_PASSWORD=replace-with-a-distinct-long-random-password
HOLOSPAN_AUDIT_DB_USER=holospan_audit
HOLOSPAN_AUDIT_DB_PASSWORD=replace-with-a-distinct-long-random-password
HOLOSPAN_CLICKHOUSE_USER=holospan
HOLOSPAN_CLICKHOUSE_PASSWORD=replace-with-a-long-random-password
HOLOSPAN_MINIO_ROOT_USER=holospan-admin
HOLOSPAN_MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
HOLOSPAN_REDIS_PASSWORD=replace-with-a-long-random-password
HOLOSPAN_IDENTITY_SESSION_SECRET=replace-with-at-least-32-random-bytes
HOLOSPAN_IDENTITY_SESSION_SECONDS=3600
# Local HTTP only. Production validation requires true behind HTTPS.
HOLOSPAN_IDENTITY_COOKIE_SECURE=false
HOLOSPAN_BOOTSTRAP_PLATFORM_ADMINS=
HOLOSPAN_OIDC_ENABLED=false
HOLOSPAN_OIDC_ISSUER=https://tenant-idp.example
# Optional internal discovery endpoint when the provider has separate front/back channels.
HOLOSPAN_OIDC_DISCOVERY_URL=
HOLOSPAN_OIDC_CLIENT_ID=holospan-tenant-web
HOLOSPAN_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
HOLOSPAN_OIDC_REDIRECT_URI=https://holospan.example/api/v1/identity-access/callback
HOLOSPAN_OIDC_FRONTEND_URI=https://holospan.example/
HOLOSPAN_OIDC_SCOPE=openid profile email
HOLOSPAN_OIDC_ALGORITHMS=RS256,ES256
HOLOSPAN_OIDC_METADATA_CACHE_SECONDS=300
HOLOSPAN_PLATFORM_OIDC_ENABLED=false
HOLOSPAN_PLATFORM_OIDC_ISSUER=https://platform-idp.example
HOLOSPAN_PLATFORM_OIDC_DISCOVERY_URL=
HOLOSPAN_PLATFORM_OIDC_CLIENT_ID=holospan-platform-web
HOLOSPAN_PLATFORM_OIDC_CLIENT_SECRET=replace-with-platform-oidc-client-secret
HOLOSPAN_PLATFORM_OIDC_REDIRECT_URI=https://platform.holospan.example/api/v1/platform/identity-access/callback
HOLOSPAN_PLATFORM_OIDC_FRONTEND_URI=https://platform.holospan.example/
HOLOSPAN_TENANT_APP_HOST=holospan.example
HOLOSPAN_PLATFORM_ADMIN_HOST=platform.holospan.example
